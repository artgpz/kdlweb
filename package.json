{
	"name": "kdl",
	"version": "1.0.0-0",
	"description": "KDL Web Project",
	"homepage": "https://github.com/kingsdigitallab/kdl#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingsdigitallab/kdl.git"
	},
	"author": "King's Digital Lab",
	"license": "MPL-2.0",
	"bugs": {
		"url": "https://forms.clickup.com/26475560/f/t7z18-74115/7YCNCR5Y6MA3KI9GX1"
	},
	"scripts": {
		"dev": "pnpm run --parallel dev",
		"lint": "pnpm run lint",
		"format": "prettier --write .",
		"build": "pnpm --filter kdl-frontend run build",
		"sync": "pnpm --filter etl run sync && pnpm --filter etl run write-projects && pnpm --filter etl run write-orgs && pnpm --filter etl run write-people",
		"cli": "pnpm --filter etl run cli",
		"release": "release-it",
		"test": "pnpm --filter kdl-frontend run test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-cypress": "^6.3.1",
		"globals": "^17.13.0",
		"prettier": "^3.8.3",
		"typescript-eslint": "^8.71.0"
	}
}
