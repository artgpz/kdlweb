---
layout: layouts/base.njk
permalink: "about/people/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber + 1 }}/{% endif %}/"
---

<section>{{ content | safe }}</section>

{% for team, items in team | groupby("team") %}
	<section id="{{ team | slugify }}">
		{% if team == "KDL" %}
			<h2>Current {{ team }} team members</h2>
		{% else %}
			<h2>
				{{ team }}
			</h2>
		{% endif %}
		<ul>
			{%- for item in items | sort(false, false, "slug") -%}
				{% set agentPage = collections.people | filter(item.slug, 'fileSlug') | first %}
				<li id="{{ item.slug }}">
					{% if team !== "Former staff" %}
						{% if agentPage.data.feature %}
							<img
								src="{{ agentPage.data.feature.image }}"
								alt="{{ agentPage.data.feature.description }}"
							/>
						{% endif %}
					{% endif %}
					<section>
						<h3>
							{% if agentPage.data.externalUrl %}
								<a href="{{ agentPage.data.externalUrl }}">
									{{ agentPage.data.title }}
								</a>
							{% elif agentPage %}
								<a href="{% route item.slug, 'People' %}">{{ agentPage.data.name }}</a>
							{% else %}
								{{ item.name }}
							{% endif %}
						</h3>
						<h2>{{ item.jobTitle }}</h2>
					</section>
				</li>
			{%- endfor -%}
		</ul>
	</section>
{%- endfor -%}
