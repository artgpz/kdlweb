		"@kevingimbel/eleventy-plugin-mermaid": "^3.0.1",
		"cypress": "^15.21.1",
		"debug": "^4.4.3",
		"dotenv": "^17.4.2",
		"eleventy-plugin-embed-everything": "^1.21.2",
		"eleventy-plugin-seo": "^0.5.2",
		"eleventy-plugin-toc": "^1.1.5",
		"luxon": "^3.7.2",
		"markdown-it": "^15.0.2",
		"markdown-it-anchor": "^9.2.1",
